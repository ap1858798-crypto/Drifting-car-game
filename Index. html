
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>3D Car Game</title>
<style>
body {
 margin:0;
 overflow:hidden;
 background:#87ceeb;
 font-family:Arial;
}
canvas {display:block;}
.controls {
 position:fixed;
 bottom:20px;
 width:100%;
 display:flex;
 justify-content:space-around;
}
button {
 width:65px;
 height:65px;
 border:2px solid white;
 border-radius:50%;
 background:#2229;
 color:white;
 font-size:25px;
}
#speed {
 position:fixed;
 top:15px;
 left:15px;
 color:white;
 font-size:22px;
}
</style>
</head>
<body>
<div id="speed">Speed: 0</div>
<div class="controls">
<button id="left">⬅️</button>
<button id="brake">🛑</button>
<button id="gas">⬆️</button>
<button id="right">➡️</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb,30,150);

const camera = new THREE.PerspectiveCamera(
75,innerWidth/innerHeight,0.1,1000
);
camera.position.set(0,5,10);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x444444,2));

const light = new THREE.DirectionalLight(0xffffff,2);
light.position.set(5,10,5);
scene.add(light);

// Road
const road = new THREE.Mesh(
new THREE.PlaneGeometry(12,300),
new THREE.MeshStandardMaterial({color:0x333333})
);
road.rotation.x=-Math.PI/2;
road.position.z=-100;
scene.add(road);

// Road lines
for(let i=0;i<60;i++){
let line=new THREE.Mesh(
new THREE.BoxGeometry(.15,.03,2),
new THREE.MeshBasicMaterial({color:0xffffff})
);
line.position.set(0,.03,-i*5);
scene.add(line);
}

// Grass and trees
for(let i=0;i<70;i++){
for(let side of [-1,1]){
let tree=new THREE.Group();
let trunk=new THREE.Mesh(
new THREE.CylinderGeometry(.2,.3,2),
new THREE.MeshStandardMaterial({color:0x754321})
);
trunk.position.y=1;
tree.add(trunk);
let leaves=new THREE.Mesh(
new THREE.SphereGeometry(1.2),
new THREE.MeshStandardMaterial({color:0x087a20})
);
leaves.position.y=2.7;
tree.add(leaves);
tree.position.set(side*(9+Math.random()*8),0,-i*5);
scene.add(tree);
}
}

// Car
const car=new THREE.Group();
const body=new THREE.Mesh(
new THREE.BoxGeometry(2,0.7,3.5),
new THREE.MeshStandardMaterial({color:0xff0000,metalness:.5,roughness:.3})
);
body.position.y=.8;
car.add(body);

const cabin=new THREE.Mesh(
new THREE.BoxGeometry(1.5,.8,1.6),
new THREE.MeshStandardMaterial({color:0x222222})
);
cabin.position.set(0,1.5,-.2);
car.add(cabin);

for(let x of [-1,1]){
for(let z of [-1.1,1.1]){
let wheel=new THREE.Mesh(
new THREE.CylinderGeometry(.4,.4,.3,24),
new THREE.MeshStandardMaterial({color:0x111111})
);
wheel.rotation.z=Math.PI/2;
wheel.position.set(x,.4,z);
car.add(wheel);
}
}
car.position.z=3;
scene.add(car);

let speed=0;
let steer=0;
let gas=false,brake=false;
let left=false,right=false;

function control(id,callback){
const b=document.getElementById(id);
b.addEventListener('touchstart',e=>{e.preventDefault();callback(true)});
b.addEventListener('touchend',e=>{e.preventDefault();callback(false)});
b.addEventListener('mousedown',()=>callback(true));
b.addEventListener('mouseup',()=>callback(false));
b.addEventListener('mouseleave',()=>callback(false));
}
control('gas',v=>gas=v);
control('brake',v=>brake=v);
control('left',v=>left=v);
control('right',v=>right=v);

function animate(){
requestAnimationFrame(animate);

if(gas) speed=Math.min(speed+.025,1);
else if(brake) speed=Math.max(speed-.05,0);
else speed=Math.max(speed-.008,0);

if(left) car.position.x-=.09;
if(right) car.position.x+=.09;

car.position.x=Math.max(-4,Math.min(4,car.position.x));

camera.position.x+=(car.position.x-camera.position.x)*.05;
camera.lookAt(car.position.x,1,-3);

scene.children.forEach(obj=>{
if(obj.position.z>12 && obj!==car){
obj.position.z-=300;
}
if(obj.geometry && obj.geometry.type==='BoxGeometry' &&
obj.position.z<10 && obj.position.z<0 &&
obj.position.y===.03){
obj.position.z+=speed*1.5;
}
});

document.getElementById('speed').innerText=
'Speed: '+Math.round(speed*200)+' km/h';

renderer.render(scene,camera);
}
animate();

window.addEventListener('resize',()=>{
camera.aspect=innerWidth/innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
